{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-pilot.local/schema/graph-event-v1",
  "title": "Research Pilot Graph Event v1",
  "type": "object",
  "required": ["schema_version", "event_id", "event_type", "created_at", "actor", "graph_id", "scope", "payload", "provenance", "human_review"],
  "properties": {
    "schema_version": {"const": "graph-event-v1"},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {
      "type": "string",
      "enum": [
        "node.created", "node.updated", "node.retired", "node.superseded",
        "link.created", "link.updated", "link.retired", "link.superseded",
        "delta.proposed", "delta.registered", "delta.accepted", "delta.integrated",
        "delta.partially_integrated", "delta.rejected", "delta.parked", "delta.revised", "delta.superseded",
        "human.reviewed", "source.attached", "graph.imported_from_markdown"
      ]
    },
    "created_at": {"type": "string"},
    "actor": {"type": "string", "enum": ["agent", "human", "system"]},
    "graph_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "enum": ["paper", "project", "program"]},
    "payload": {"type": "object"},
    "provenance": {"type": "array", "items": {"type": "string"}},
    "human_review": {"$ref": "#/$defs/humanReview"}
  },
  "$defs": {
    "humanReview": {"type": "string", "enum": ["pending", "approved", "rejected"]},
    "confidence": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
    "deltaLifecycleStatus": {"type": "string", "enum": ["proposed", "accepted", "rejected", "parked", "revised"]},
    "nodeLifecycleStatus": {"type": "string", "enum": ["active", "retired", "superseded", "merged", "split_from"]},
    "evolutionType": {
      "type": "string",
      "enum": ["add", "refine", "split", "merge", "promote", "demote", "reframe", "decompose", "retire", "connect", "bound", "clarify", "clarify_translation", "strengthen", "weaken"]
    }
  }
}
